# bomi 服务端环境变量示例
# 复制为 .env 并填入真实值；.env 禁止提交到 git。

# ===== 服务 =====
SERVER_PORT=8080
SERVER_MODE=debug

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bomi

# ===== JWT =====
JWT_SECRET=please-change-to-random-long-string
JWT_EXPIRE_HOURS=168

# ===== AI 调用（Key 禁止硬编码到代码，仅在此读取） =====
AI_PROVIDER=openai
AI_API_KEY_DEV=
AI_API_KEY_PROD=
AI_BASE_URL_DEV=https://api.openai.com/v1
AI_BASE_URL_PROD=https://api.openai.com/v1
AI_DEFAULT_MODEL_DEV=gpt-4o-mini
AI_DEFAULT_MODEL_PROD=gpt-4o
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_STREAM=false
AI_RETRY_COUNT=2
AI_TIMEOUT_MS=30000

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 阿里云短信 =====
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=bomi
SMS_TEMPLATE_CODE=

# ===== 微信登录 =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== Apple Sign In =====
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.bomi.app
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
